# SallyNet LTE monitor config — installed to /etc/sally/lte-monitor.env (mode 0600).
# The deploy script renders this from the repo .env; this file is the documented
# template. Holds the LuCI admin password, so it never lives in the repo filled in.
QX210_HOST=192.168.2.1
QX210_LUCI_USER=admin
QX210_LUCI_PASS=REPLACE_WITH_LUCI_ADMIN_PASSWORD

# Cellular WAN interface on the router (wwan0 = LTE modem; tx=uplink, rx=down).
LTE_IFACE=wwan0

# Local mosquitto on campingpi (anonymous, on-LAN). Repoint to the N100 later.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_PREFIX=sally/telemetry/lte

# Poll cadence (seconds) and Home Assistant auto-discovery.
INTERVAL=10
HA_DISCOVERY=1
HA_PREFIX=homeassistant
