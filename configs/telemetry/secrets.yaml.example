# ESPHome secrets for the SallyNet sensor nodes in this folder.
# Copy to secrets.yaml (same folder, gitignored) and fill in. ESPHome resolves
# `!secret <name>` in the node YAMLs from this file at compile time.

wifi_password: REPLACE_WITH_WIFI_PASSWORD          # SallyNet SSID PSK (QX210)
ap_password: REPLACE_WITH_FALLBACK_AP_PASSWORD     # captive-portal fallback hotspot
ota_password: REPLACE_WITH_OTA_PASSWORD            # ESPHome OTA upload password
api_encryption_key: REPLACE_WITH_BASE64_32_BYTE_KEY  # only if the native API block is enabled
