[Unit]
Description=Sally dashboard API (sally-api) — the Roku-facing HTTP surface on :8090
After=network-online.target gpsd.socket
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/sally/sally-api
ExecStart=/usr/bin/python3 /opt/sally/sally-api/app.py
Restart=on-failure
RestartSec=3
# Runtime secrets + host overrides (TILE_API_KEY for the map tiles, etc.). Written by
# scripts/deploy-sally-api.sh from the repo .env; '-' means start fine if it's absent. Lives
# OUTSIDE the rsync'd app dir so `rsync --delete` never removes it.
EnvironmentFile=-/opt/sally/sally-api.env
# The home anchor (SALLY_HOME_LAT/LON) comes from the repo .env via sally-api.env above; the
# committed default is a public downtown-Edmonton point. Override the port here if needed:
# Environment=SALLY_HOME_LAT=53.5461 SALLY_HOME_LON=-113.4938 SALLY_API_PORT=8090

[Install]
WantedBy=multi-user.target
