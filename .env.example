# SallyNet local secrets — copy to .env and fill in. .env is gitignored.
#
# Usage:
#   set -a && . ./.env && set +a

# campingpi (always-on Pi host). 10.66.12.216 via WireGuard, 192.168.2.216 on-LAN.
PI_HOST=10.66.12.216
PI_LAN_HOST=192.168.2.216
PI_USER=pi
PI_PASSWORD=REPLACE_WITH_PI_PASSWORD

# SallyNet WiFi (QX210 SSID).
WIFI_SSID=SallyNet
WIFI_PASSWORD=REPLACE_WITH_WIFI_PASSWORD

# QX210-NW2 router — LuCI web admin (SSH/dropbear currently disabled).
#   on-LAN http://192.168.2.1 · via WG http://10.66.12.1
# Live counters: GET /cgi-bin/luci/admin/status/realtime/bandwidth_status/<iface>
#   -> [epoch, rxBytes, rxPkts, txBytes, txPkts]
QX210_HOST=192.168.2.1
QX210_HOST_VPN=10.66.12.1
QX210_LUCI_USER=admin
QX210_LUCI_PASS=REPLACE_WITH_LUCI_ADMIN_PASSWORD
# WAN map: wwan0 = LTE modem (tx=uplink, rx=down); eth1 = wired WAN
QX210_WAN_CELL_IFACE=wwan0
QX210_WAN_WIRED_IFACE=eth1

# HouseWall Roku fleet (sibling project rokuApp) dev password — reference only; the
# Camperoku dev password is ROKU_DEV_PASSWORD in roku-channel/.env.
HOUSEWALL_ROKU_DEV_PASSWORD=REPLACE_WITH_HOUSEWALL_DEV_PASSWORD

# Thunderforest raster tile API key for the ambient map compositor (/api/map.png).
# Sign up at https://www.thunderforest.com/ — NOTE: the free Hobby/Solo tiers do NOT permit the
# server-side caching + pre-seed this design relies on (needs Small Business+ or a custom plan —
# being arranged); tiles.py's circuit breaker keeps request rates polite meanwhile. Without a key
# the basemap renders as gap-fill — the arrow, breadcrumb trail, waypoints and POI still draw.
# deploy-sally-api.sh writes this into /opt/sally/sally-api.env on the Pi (mode 600).
TILE_API_KEY=REPLACE_WITH_THUNDERFOREST_KEY
