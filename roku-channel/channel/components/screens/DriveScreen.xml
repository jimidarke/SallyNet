<?xml version="1.0" encoding="utf-8" ?>
<!-- DriveScreen — rolling trip readout from /api/state.gps + .drive. -->
<component name="DriveScreen" extends="Group">
    <interface>
        <field id="state" type="assocarray" onChange="onState" />
    </interface>
    <script type="text/brightscript" uri="DriveScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/Config.brs" />
    <children>
        <Rectangle width="1920" height="1080" color="0xE8DCC8FF" />

        <!-- header band + twin stripe -->
        <Rectangle width="1920" height="96" color="0xE8A044FF" />
        <Rectangle translation="[0, 96]"  width="1920" height="5" color="0xC8462EFF" />
        <Rectangle translation="[0, 101]" width="1920" height="5" color="0xE8702EFF" />
        <Label translation="[60, 26]" color="0x2B2A26FF" font="font:MediumBoldSystemFont" text="DRIVE" />
        <Label id="clock" translation="[1440, 26]" width="420" horizAlign="right"
               color="0x2B2A26FF" font="font:MediumBoldSystemFont" text="" />

        <!-- hero speed -->
        <Label id="speed" translation="[120, 300]" width="900"
               color="0x2B2A26FF" font="font:LargeBoldSystemFont" text="--" />
        <Label translation="[120, 380]" color="0x2B2A26AA" font="font:MediumBoldSystemFont" text="km/h" />

        <!-- right column readouts -->
        <Label id="r1" translation="[1080, 300]" width="780" color="0x2B2A26FF" font="font:MediumBoldSystemFont" text="" />
        <Label id="r2" translation="[1080, 376]" width="780" color="0x2B2A26FF" font="font:MediumBoldSystemFont" text="" />
        <Label id="r3" translation="[1080, 452]" width="780" color="0x2B2A26FF" font="font:MediumBoldSystemFont" text="" />
        <Label id="r4" translation="[1080, 528]" width="780" color="0x2B2A26FF" font="font:MediumBoldSystemFont" text="" />

        <Label id="footer" translation="[60, 1006]" width="1800"
               color="0x2B2A26AA" font="font:SmallSystemFont" text="" />
    </children>
</component>
