<?xml version="1.0" encoding="utf-8" ?>
<!-- MediaCard — RowList item: poster + caption + twin red/orange focus stripe. A muted
     placeholder sits behind the poster (so a slow/missing poster never blanks), the poster
     fades in on load, and the whole card scales up slightly with focus (Netflix zoom).
     RowList sets itemContent (a browse ContentNode) and focusPercent on each item. -->
<component name="MediaCard" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContent" />
        <field id="focusPercent" type="float" value="0.0" onChange="onFocusChange" />
        <field id="width" type="float" value="300" />
        <field id="height" type="float" value="224" />
    </interface>
    <script type="text/brightscript" uri="MediaCard.brs" />
    <script type="text/brightscript" uri="pkg:/source/Config.brs" />
    <children>
        <!-- placeholder shown until (or when there is no) poster -->
        <Rectangle id="bg" width="300" height="169" color="0xD8C9B0FF" />
        <Poster id="poster" width="300" height="169" loadDisplayMode="scaleToZoom"
                uri="pkg:/images/transparent.png" opacity="0.0" />
        <Animation id="fadeIn" duration="0.28" easeFunction="outQuad">
            <FloatFieldInterpolator id="fadeInterp" key="[0.0, 1.0]" keyValue="[0.0, 1.0]"
                                    fieldToInterp="poster.opacity" />
        </Animation>
        <!-- kidSafe badge: only shown once overrides/TMDB data sets itemContent.kidSafe -->
        <Rectangle id="kidBadgeBg" translation="[6, 6]" width="70" height="26" color="0x6B9080FF" visible="false" />
        <Label id="kidBadgeLabel" translation="[12, 10]" width="60" height="20"
               color="0xFFF8E1FF" font="font:SmallBoldSystemFont" text="KIDS" visible="false" />
        <Rectangle id="stripeRed" translation="[0, 169]" width="300" height="4" color="0xC8462EFF" visible="false" />
        <Rectangle id="stripeOrange" translation="[0, 173]" width="300" height="4" color="0xE8702EFF" visible="false" />
        <Label id="cap" translation="[4, 182]" width="292" height="40"
               color="0x2B2A26FF" font="font:SmallSystemFont" wrap="false" />
    </children>
</component>
